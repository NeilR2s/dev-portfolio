{
  "name": "dev-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run content:generate && bun --bun vite --host 127.0.0.1",
    "build": "bun scripts/build.mjs",
    "lint": "eslint .",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "content:generate": "bun scripts/content.mjs",
    "content:check": "bun scripts/content.mjs --check",
    "media:generate": "bun scripts/media.mjs",
    "test": "bun test tests/content.test.js",
    "test:e2e": "bunx --bun playwright test",
    "verify": "bun run content:check && bun run lint && bun run test && bun run build && bun run test:e2e"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "baseline-browser-mapping": "^2.11.21",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "sharp": "^0.35.4",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.6"
  }
}
